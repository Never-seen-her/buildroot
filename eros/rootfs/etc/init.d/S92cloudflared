#!/bin/sh
# Start and stop the Cloudflare Tunnel client.

DAEMON="/usr/bin/cloudflared"
PIDFILE="/var/run/cloudflared/cloudflared.pid"
LOG_DIR="/var/log/cloudflared"
LOG_FILE="${LOG_DIR}/cloudflared.log"

is_running() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE") || return 1
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null
}

start() {
    mkdir -p "${PIDFILE%/*}" || return 1
    mkdir -p "$LOG_DIR" || return 1
    if is_running; then
        echo "cloudflared is already running"
        return 0
    fi

    printf "Starting %s: " "$DAEMON"
    start-stop-daemon --start --background --make-pidfile \
        --pidfile "$PIDFILE" --exec "$DAEMON" -- \
        --logfile "$LOG_FILE" \
        --autoupdate-freq 24h0m0s \
        --config /etc/cloudflared/config.yml tunnel run
    status=$?
    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi
    return "$status"
}

stop() {
    printf "Stopping %s: " "$DAEMON"
    if ! is_running; then
        rm -f "$PIDFILE"
        echo "not running"
        return 0
    fi

    pid=$(cat "$PIDFILE")
    start-stop-daemon --stop --pidfile "$PIDFILE" --exec "$DAEMON"
    status=$?
    if [ "$status" -ne 0 ]; then
        echo "FAIL"
        return "$status"
    fi

    count=0
    while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "FAIL (timed out)"
        return 1
    fi

    rm -f "$PIDFILE"
    echo "OK"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop && start
        ;;
    status)
        if is_running; then
            echo "cloudflared is running"
        else
            echo "cloudflared is stopped"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload|status}"
        exit 1
        ;;
        esac



exit $?
