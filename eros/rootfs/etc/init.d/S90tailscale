#!/bin/sh
#
# Start Tailscale in userspace-networking mode.
#

DAEMON="/usr/bin/tailscaled"
CLIENT="/usr/bin/tailscale"
SOCKET="/var/run/tailscale/tailscaled.sock"
PIDFILE="/var/run/tailscale/tailscaled.pid"
STATE_DIR="/tmp/tailscale"

start() {
	mkdir -p /var/run/tailscale "$STATE_DIR" /var/lib/tailscale || return 1
	TS_LOGS_DIR="$STATE_DIR"
	export TS_LOGS_DIR

	printf "Starting %s: " "$DAEMON"
	count=0
	while [ "$count" -lt 60 ]; do
		start-stop-daemon --start --background --make-pidfile \
			--pidfile "$PIDFILE" --exec "$DAEMON" -- \
			--tun=userspace-networking \
			--state=/var/lib/tailscale/tailscaled.state \
			--statedir="$STATE_DIR" \
			--socket="$SOCKET"
		status=$?
		if [ "$status" -eq 0 ]; then
			break
		fi

		count=$((count + 1))
		if [ "$count" -lt 60 ]; then
			echo "start-stop-daemon failed; retrying in 1 second ($count/60)"
			sleep 1
		fi
	done
	if [ "$status" -ne 0 ]; then
		echo "FAIL (start timed out after 60 seconds)"
		return "$status"
	fi

	# Wait for the local control socket before running tailscale up.
	count=0
	while [ ! -S "$SOCKET" ] && [ "$count" -lt 10 ]; do
		sleep 1
		count=$((count + 1))
	done

	if [ ! -S "$SOCKET" ]; then
		echo "FAIL (socket unavailable)"
		return 1
	fi

	if "$CLIENT" --socket="$SOCKET" up; then
		echo "OK"
	else
		echo "FAIL (tailscale up)"
		return 1
	fi
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE")
		if kill -0 "$pid" 2>/dev/null; then
			start-stop-daemon --stop --pidfile "$PIDFILE" --exec "$DAEMON"
			status=$?
			if [ "$status" -ne 0 ]; then
				echo "FAIL"
				return "$status"
			fi
			count=0
			while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 10 ]; do
				sleep 1
				count=$((count + 1))
			done
			if kill -0 "$pid" 2>/dev/null; then
				echo "FAIL (timed out)"
				return 1
			fi
		fi
		rm -f "$PIDFILE"
	fi
	echo "OK"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop && start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac

exit $?
