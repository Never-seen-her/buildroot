#!/bin/sh
#
# weston	Starts weston (Wayland compositor, DRM/KMS backend).
#
# Weston runs in the foreground, so start-stop-daemon backgrounds it.
#

#==========================================================
#		Default environment
#		(inherited by weston and everything it starts)
#==========================================================
# Must be a private directory (mode 0700) owned by the user running weston,
# and it must be empty on every boot -> keep it on tmpfs.
export XDG_RUNTIME_DIR=/tmp/wayland
export WAYLAND_DISPLAY=wayland-1

# WPE / Cog cache and data directories, also on tmpfs (avoid eMMC/SD writes).
export XDG_CACHE_HOME=/tmp/weston/wpe-cache
export XDG_DATA_HOME=/tmp/weston/wpe-data

# Cog: fullscreen
export COG_PLATFORM_WL_VIEW_FULLSCREEN=1
# Cog: force WebKit compositing mode (hardware accelerated)
export WEBKIT_FORCE_COMPOSITING_MODE=1

DAEMON="weston"
EXEC="/usr/bin/$DAEMON"

PIDFILE="/tmp/$DAEMON/$DAEMON.pid"
LOGFILE="/tmp/$DAEMON/$DAEMON.log"

is_running() {
	start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE" --exec "$EXEC"
}

start() {
	if is_running; then
		echo "$DAEMON is already running"
		return 0
	fi
	mkdir -p "$XDG_RUNTIME_DIR" "${PIDFILE%/*}" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" || return 1
	chmod 700 "$XDG_RUNTIME_DIR" || return 1

	printf "Starting %s: " "$DAEMON"
	if ! start-stop-daemon --start --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "$EXEC" -- \
		--backend=drm-backend.so --socket="$WAYLAND_DISPLAY" --log="$LOGFILE"; then
		echo "FAIL"
		return 1
	fi

	# Let Weston create and manage its Wayland socket and lock.
	i=0
	while [ "$i" -lt 50 ]; do
		if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && is_running; then
			echo "OK"
			return 0
		fi
		sleep 0.1
		i=$((i + 1))
	done
	echo "FAIL (see $LOGFILE)"
	return 1
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	if is_running && ! start-stop-daemon --stop --quiet \
		--pidfile "$PIDFILE" --exec "$EXEC"; then
		echo "FAIL"
		return 1
	fi

	i=0
	while is_running; do
		if [ "$i" -ge 50 ]; then
			echo "FAIL (timed out)"
			return 1
		fi
		sleep 0.1
		i=$((i + 1))
	done
	rm -f "$PIDFILE" || return 1
	echo "OK"
}

restart() {
	stop && start
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		restart
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit $?
