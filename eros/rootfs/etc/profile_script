#!/bin/sh
set -eu

PROFILE="$1/etc/profile"
TEMP_PROFILE=$(mktemp "${PROFILE}.XXXXXX")
trap 'rm -f "$TEMP_PROFILE"' 0

{
    # Remove previous Eros settings and duplicate prompts from older builds.
    perl -0777 -pe '
        s/^\n?# BEGIN Buildroot Eros settings\n.*?^# END Buildroot Eros settings(?:\n|\z)//gms;
        die "Unterminated Buildroot Eros settings block\n" if /^# BEGIN Buildroot Eros settings$/m;
        s/^\n# Custom prompt\nexport PS1=\x27\\e\[01;34m\\u\@\$PWD\\e\[00m\$ \x27(?:\n|\z)//gm;
        $_ .= "\n" if length && !/\n\z/;
    ' < "$PROFILE"

    cat <<'EOF'

# BEGIN Buildroot Eros settings
export PYTHONPYCACHEPREFIX="/tmp/python-pycache-$(id -u)"
export HISTFILE=/tmp/.ash-history
if [ -n "${PS1-}" ]; then
    export PS1='\e[01;34m\u@$PWD\e[00m$ '
fi

if [ -t 0 ] && [ "$(tty 2>/dev/null)" = "/dev/ttyS2" ]; then
    stty isig intr '^C' -ixon -ixoff -crtscts
fi
# END Buildroot Eros settings
EOF
} > "$TEMP_PROFILE"

if ! cmp -s "$PROFILE" "$TEMP_PROFILE"; then
    chmod --reference="$PROFILE" "$TEMP_PROFILE"
    mv -f "$TEMP_PROFILE" "$PROFILE"
fi
