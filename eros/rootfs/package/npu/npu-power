#!/bin/sh
# RK3399Pro NPU 上电脚本 (适配 libgpiod v1 + 6.18主线内核)

# ---- 确保 debugfs 已挂载 ----
DEBUGFS=/sys/kernel/debug
if ! awk '$2 == "/sys/kernel/debug" && $3 == "debugfs" { found = 1 }
    END { exit !found }' /proc/mounts; then
    mkdir -p "$DEBUGFS" || { echo "cannot create $DEBUGFS" >&2; exit 1; }
    mount -t debugfs debugfs "$DEBUGFS" || {
        echo "failed to mount debugfs at $DEBUGFS" >&2
        exit 1
    }
fi

# ---- 前置检查 ----
command -v gpioset >/dev/null 2>&1 || { echo "gpioset not found" >&2; exit 1; }
[ -d "$DEBUGFS/clk" ] || { echo "clock debugfs is unavailable" >&2; exit 1; }

SHORT=0.2

# libgpiod v1: 芯片号作为位置参数，用 -- 分隔偏移量，避免被误解析
set_gpio() {
    # $1=chip, $2=offset, $3=value
    gpioset -- "$1" "$2=$3" &
}

kill_gpioset() { killall -15 gpioset 2>/dev/null; }

# ---- 1. 时钟配置 ----
# rk808-clkout2 可能作为时钟源被 clk_wifi_pmu 间接管理，此处仅操作可用的 wifi 时钟
if [ -e /sys/kernel/debug/clk/clk_wifi_pmu/clk_rate ]; then
    echo 24000000 > /sys/kernel/debug/clk/clk_wifi_pmu/clk_rate
fi

# ---- 2. 复位：拉低相关 GPIO ----
kill_gpioset

set_gpio 0 10 0
sleep "$SHORT"
set_gpio 1 22 0
set_gpio 1 23 0
set_gpio 1 24 0
set_gpio 0 11 0
set_gpio 0 4  0
set_gpio 1 3  0
set_gpio 1 0  0
set_gpio 4 21 0
sleep "$SHORT"
kill_gpioset

# ---- 3. 按上电顺序拉高 ----
set_gpio 0 4 1
sleep "$SHORT"
set_gpio 0 10 1
sleep "$SHORT"
set_gpio 0 11 1
sleep "$SHORT"

# 使能 wifi 时钟 (如果 debugfs 节点存在)
if [ -e /sys/kernel/debug/clk/clk_wifi_pmu/clk_prepare_enable ]; then
    echo 1 > /sys/kernel/debug/clk/clk_wifi_pmu/clk_prepare_enable
fi

set_gpio 1 22 1
sleep "$SHORT"
set_gpio 1 23 1
sleep "$SHORT"
set_gpio 1 24 1
sleep 1
set_gpio 1 0 1
sleep 3
set_gpio 4 21 1

# 注意：v1 的 gpioset 默认会阻塞以保持电平，脚本中的 & 使其后台运行。
# 全部设置完毕后，需要保持这些后台进程存活，以维持最终的 GPIO 状态。
# 如果系统重启或需要手动关闭 NPU，再统一 killall gpioset。

